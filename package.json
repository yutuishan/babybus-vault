{
  "name": "babybus-vault",
  "version": "0.1.0",
  "private": true,
  "description": "宝宝巴士 - 本地离线加密文档保险箱（Electron + Vue 3）",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24.7.0"
  },
  "build": {
    "appId": "com.babybus.vault",
    "productName": "宝宝巴士",
    "copyright": "Copyright © 2026",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/{node_modules,__tests__,tests,*.spec.*,*.map}"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}",
      "splashImage": null
    },
    "mac": {
      "icon": "build/icon.ico",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.productivity"
    }
  },
  "scripts": {
    "prepare:pdf": "node scripts/prepare-pdf-assets.mjs",
    "dev": "npm run prepare:pdf && node scripts/dev.mjs",
    "build": "npm run prepare:pdf && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "start": "electron .",
    "package": "npm run build && npm run asar && node scripts/package-portable.mjs",
    "asar": "node node_modules/@electron/asar/bin/asar.js pack dist app.asar",
    "probe": "node scripts/probe-argon2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "hash-wasm": "^4.12.0",
    "markdown-it": "^14.3.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0",
    "vue": "^3.5.42"
  }
}
